# ===== 运行时路径配置（本机专用，不入 git）=====
# 复制 .env.example 为 .env 并按需修改

# 音频源目录（视频课程根目录，程序会遍历其中的视频文件）
COURSE_SRC_DIR=F:\Download\程序员k哥2.0课程

# 音频输出目录（默认: 项目根/audio）
AUDIO_DIR=

# ffmpeg / ffprobe 可执行文件路径（留空则从 PATH 查找）
FFMPEG_PATH=
FFPROBE_PATH=

# 服务器端口（默认 8792）
KAUDIO_PORT=8792

# 本地测试输出目录（E2E 截图等，默认: 项目根/.cache）
CACHE_DIR=
